\section{Introduction to Algebraic Geometry}

\subsection{Overview}

\begin{frame}{Algebraic sets}
Classically, algebraic geometry studies the set of complex solutions to a system of polynomial equations, eg.
$$\left\lbrace
\begin{array}{cc}
p_1(x_1,\dots, x_n) &= 0\\
p_2(x_1,\dots, x_n) &= 0\\
\dots\\
p_m(x_1,\dots, x_n) &= 0\\
\end{array}
\right.$$
The subset $V\subseteq\mathbb C^n$ of all solutions is called a \textbf{algebraic set}.\\
{\color{Notation:}} 
$$V(S) = \{(a_1,\dots, a_n)\in\mathbb{C}^n: p(a_1,\dots, a_n) = 0\ \forall p\in S\}.$$
\end{frame}

\begin{frame}{Example: conic}
\textbf{Example:}
Polynomial set $S = \{y^2-x\}$.\\
The set of solutions
$$V(S) = \{(a,b)\in\mathbb{C}^2: b^2=a\}$$
forms an algebraic set called a \textbf{conic}.\\
$${\color{red}\text{What does this set of solutions look like?}}$$ 
\end{frame}

\begin{frame}{Example: conic}
Two flavors of square root:
\begin{itemize}
\item Principal branch:
$$g_I(z) = \sqrt{z} = r^{1/2}e^{i\theta},\quad r\geq 0,\ \theta\in (-\pi,\pi)$$
Domain: $B_I = \mathbb{C}\backslash (-\infty,0)$
\item Negative branch:
$$g_{II}(z) = \sqrt{z} = r^{1/2}e^{i\theta},\quad r\geq 0,\ \theta\in (0,2\pi)$$
Domain: $B_{II} = \mathbb{C}\backslash (0,\infty)$
\end{itemize}
\end{frame}

\begin{frame}{Example: conic}
Two sets of solutions:
$$
V_{I} = \{(x,g_{I}(x)): x\in B_{I}\}\quad\text{and}\quad
V_{II} = \{(x,g_{II}(x)): x\in B_{II}\}
$$
Glue together smoothly on boundaries!
\begin{center}
\includegraphics[width=2in]{fig/riemann_sqrt.jpg}
\end{center}
\end{frame}

\begin{frame}{Example: elliptic curve}
\textbf{Example:}
Polynomial set $S = \{y^2-x(x^2-1)\}$.\\
The set of solutions
$$V(S) = \{(a,b): b^2=a(a^2-1)\}$$
forms an algebraic set called an \textbf{elliptic curve}.\\
$${\color{red}\text{What does this set of solutions look like?}}$$ 
\end{frame}

\begin{frame}{Example: elliptic curve}
Defining $\sqrt{x(x^2-1)}$?
\begin{itemize}
\item Region I:
$$D_{I} = \mathbb{C}\ \backslash\ (-1,0)\cup (1,\infty)$$
$$a\in D_{I}\ \Rightarrow\ a(a^2-1)\in B_{I}$$
$$f_I(x) = \sqrt{x(x^2-1)}: D_I\rightarrow B_I\xrightarrow{\text{principal branch}} \mathbb{C}$$
\item Region II:
$$D_{II} = \mathbb{C}\ \backslash\ (-\infty,-1)\cup(0,1)$$
$$a\in D_{II}\ \Rightarrow\ a(a^2-1)\in B_{II}$$
$$f_{II}(x) = \sqrt{x(x^2-1)}: D_{II}\rightarrow B_{II}\xrightarrow{\text{negative branch}} \mathbb{C}$$
\end{itemize}
\end{frame}

\begin{frame}{Example: elliptic curve}
Two sets of solutions:
$$
U_{I} = \{(a,f_{I}(a)): a\in D_{I}\}\quad\text{and}\quad
U_{II} = \{(a,f_{II}(a)): a\in D_{II}\}
$$
Glue together smoothly on boundaries!
$${\color{red}\text{Creates a torus}}$$
\end{frame}

\begin{frame}{Algebra and geometry}
Basic data:
\begin{itemize}
\item ring: $R = \mathbb C[x_1,\dots, x_n]$ and subset $S\subseteq R$
\item ideal: $I(S) = \text{span}\{pq: p\in S,\ q\in R\}$
\end{itemize}
Fundamental idea:
\begin{itemize}
\item the geometry of $V(S)$ tells us the algebra of $R/I_S$
\item the algebra of $R/I_S$ tells us the geometry of $V(S)$
\end{itemize}
\end{frame}

\begin{frame}{Points and maximal ideals}
$$S = \{p_1(x_1,\dots, x_n),\dots, p_m(x_1,\dots, x_n)\}$$
The following are equivalent:
\begin{itemize}
\item solutions of
$$\left\lbrace
\begin{array}{cc}
p_1(x_1,\dots, x_n) &= 0\\
p_2(x_1,\dots, x_n) &= 0\\
\dots\\
p_m(x_1,\dots, x_n) &= 0\\
\end{array}
\right.$$
\item points in $V(S)$
\item ring homomorphisms $R/I(S)\rightarrow\mathbb{C}$
\item maximal ideals of $R$ containing $I(S)$
\end{itemize}
\end{frame}

\begin{frame}{Points and maximal ideals}
$$R = \mathbb C[x],\ \ S = \{0\}$$
\begin{itemize}
\item $x=a$ is a solution of
$$\left\lbrace
\begin{array}{cc}
0 &= 0\\
\right.$$
for every $a\in\mathbb{C}$
\item the maximal ideals of $R$ are
$$\langle x-a\rangle = \{(x-a)q(x): q\in \mathbb C[x]\}$$
for each $a\in \mathbb{C}$
\end{itemize}
\end{frame}

\begin{frame}{Points and maximal ideals}
$$R = \mathbb C[x,y],\ \ S = \{xy\}$$
\begin{itemize}
\item  $(x,y)=(a,0)$ or $(x,y) = (0,a)$ solves
$$\left\lbrace
\begin{array}{cc}
xy &= 0\\
\right.$$
for every $a\in\mathbb{C}$
\item quotient ring $R/I(S) = \{(x-a)y\}$
\item the maximal ideals of $R$ are
$$\langle x-a,y-b\rangle = \{(x-a)q_1(x,y) + (y-b)q_2(x,y): q_1,q_2\in \mathbb C[x]\}$$
for each $a\in \mathbb{C}$
\item to contain $xy$, must have $a=0$ or $b=0$
\end{itemize}
\end{frame}

\begin{frame}{Algebraic and geometric dimension}
The algebraic dimension or \textbf{Krull dimension} of a commutative ring $R$ the largest integer $d$ for which there are prime ideals 
$$I_0\substeq I_1\subseteq I_2\subseteq \dots\subseteq I_d$$
\textbf{Examples:}
\begin{itemize}
\item the Krull dimension of $\mathbb C[x_1,\dots, x_n]$ is $n$
\item the Krull dimension of $\mathbb C[x,y]/\langle y^2-x(x^2-1)\rangle$ is $1$
\end{itemize}
\textbf{Theorem:}
The Krull dimension of $R/I(S)$ is the complex dimension (half the real dimension) of $V(S)$.
\end{frame}


